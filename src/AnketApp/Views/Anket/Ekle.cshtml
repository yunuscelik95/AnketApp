@model AnketFormModel
@{
    ViewData["Title"] = "Yeni Anket";
}

<h1 class="h3 mb-3">Yeni Anket</h1>
<form asp-action="Ekle" method="post" class="col-lg-6">
    <partial name="_AnketForm" model="Model" />
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-link">Vazgeç</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
