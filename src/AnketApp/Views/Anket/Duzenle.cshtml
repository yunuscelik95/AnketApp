@model AnketFormModel
@{
    ViewData["Title"] = "Anketi Düzenle";
}

<h1>Anketi Düzenle</h1>

<form asp-action="Duzenle" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Anket adı</label>
        <input asp-for="Ad" class="form-control" />
        <span asp-validation-for="Ad" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Açıklama</label>
        <textarea asp-for="Aciklama" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <input asp-for="Aktif" />
        <label>Aktif</label>
    </div>

    <button type="submit" class="btn btn-primary">Güncelle</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
