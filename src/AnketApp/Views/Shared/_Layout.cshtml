<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AnketApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-4">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Anket" asp-action="Index">AnketApp</a>
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" asp-controller="Anket" asp-action="Index">Anketler</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Anket" asp-action="Ekle">Yeni Anket</a></li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Mesaj"] is string mesaj)
            {
                <div class="alert alert-success">@mesaj</div>
            }
            @if (TempData["Hata"] is string hata)
            {
                <div class="alert alert-danger">@hata</div>
            }
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">AnketApp · ASP.NET Core MVC + Dapper + MSSQL</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
